NODE_ENV=development
LOG_LEVEL=debug
PORT=3000

USE_MOCK_SALESFORCE=false
# Temporary VM-only transition mode. Do not use in Convex.
SALESFORCE_AUTH_MODE=SF_CLI
SALESFORCE_CLI_TARGET_ORG=
# Convex target mode. Supply only in the deployment secret store, never here.
# SALESFORCE_AUTH_MODE=CLIENT_CREDENTIALS
# SALESFORCE_LOGIN_URL=https://your-my-domain.my.salesforce.com
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=66.0
LIVE_TEST_EMAIL=namit@warpdrivetech.in

ALLOW_SAFE_SALESFORCE_TEST_WRITES=false
ALLOW_LIVE_BUSINESS_WRITES_FROM_SLACK=false

# The Slack app uses signed HTTP request delivery. The Convex runtime does not
# use this VM-only setting, but keeping it false avoids an accidental Socket
# Mode rollback when validating the legacy endpoint.
SLACK_SOCKET_MODE=false
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_SIGNING_SECRET=
# The manifest and both HTTP runtimes use the same slash command.
SLACK_COMMAND=/dms
# Required for channel-based ARS/return approval requests in Convex. Do not
# supply a default channel ID in source code.
SLACK_SALES_CHANNEL_ID=
