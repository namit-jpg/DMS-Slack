{
  "display_information": {
    "name": "WD RCG DMS SFA Assistant"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false
    },
    "bot_user": {
      "display_name": "DMSFA",
      "always_online": true
    },
    "slash_commands": [
      {
        "command": "/dms",
        "description": "Open DMS/SFA dashboard",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "users:read",
        "users:read.email",
        "im:write",
        "files:read",
        "channels:read",
        "channels:join"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "app_home_opened"
      ]
    },
    "interactivity": {
      "is_enabled": true
    },
    "socket_mode_enabled": false,
    "org_deploy_enabled": false
  }
}
