{
  "name": "dmsfa-slack-app",
  "version": "0.1.0",
  "private": true,
  "description": "Slack-first DMS/SFA application backed by Salesforce",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ convex/",
    "typecheck": "tsc --noEmit",
    "convex:typecheck": "tsc --noEmit --project tsconfig.convex.json",
    "setup:live-env": "node scripts/setupLiveEnv.js",
    "sf:cli-auth-check": "npx tsx scripts/verifySalesforceCliAuth.ts",
    "sf:capability-audit": "npx tsx scripts/salesforceCapabilityAudit.ts",
    "sf:smoke-test": "npx tsx scripts/smokeTest.ts",
    "live:check": "npx tsx scripts/liveCheck.ts",
    "live:dev": "set USE_MOCK_SALESFORCE=false&& set SALESFORCE_AUTH_MODE=SF_CLI&& npx tsx watch src/server.ts",
    "live:smoke": "set USE_MOCK_SALESFORCE=false&& npx tsx scripts/smokeTest.ts",
    "live:capability-audit": "set USE_MOCK_SALESFORCE=false&& npx tsx scripts/salesforceCapabilityAudit.ts"
  },
  "dependencies": {
    "@slack/bolt": "^3.22.0",
    "convex": "1.43.0",
    "dotenv": "^17.4.2",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@slack/cli-hooks": "^1.3.2",
    "@types/node": "^22.10.0",
    "@types/uuid": "^10.0.0",
    "convex-test": "0.0.55",
    "eslint": "^9.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  }
}
